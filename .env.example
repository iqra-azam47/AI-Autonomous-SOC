# ==============================================================
# AI Autonomous SOC - Environment Configuration Example
# Copy this file to .env and configure the appropriate values.
# NEVER commit .env to version control!
# ==============================================================

# Application Environment (development, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local SQLite fallback: sqlite:///./soc.db
# Production Neon PostgreSQL: postgresql://<user>:<password>@<ep-pooler>.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./soc.db

# JWT Security
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=supersecret-jwt-key-change-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key (Server-side ONLY, never exposed to frontend)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Threat Intelligence Providers (Optional External Enrichment)
# AbuseIPDB API Key: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=
# VirusTotal API Key: https://www.virustotal.com/gui/user/apiKey
VIRUSTOTAL_API_KEY=

# CORS & URL Configuration
# In production, specify the exact frontend origin(s) comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_SIMULATION=15/minute
RATE_LIMIT_INGESTION=30/minute
